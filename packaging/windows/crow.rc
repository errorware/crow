1 ICON "crow.ico"

1 VERSIONINFO
FILEVERSION 0,8,9,0
PRODUCTVERSION 0,8,9,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Errorware"
            VALUE "FileDescription", "Crow - Native Linux Server Manager over SSH"
            VALUE "FileVersion", "0.8.9"
            VALUE "InternalName", "crow"
            VALUE "LegalCopyright", "Copyright (c) Errorware (MIT License)"
            VALUE "OriginalFilename", "crow.exe"
            VALUE "ProductName", "Crow"
            VALUE "ProductVersion", "0.8.9"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
